# Postgres connection string (Supabase, Neon, Railway, or your own Postgres).
# On Supabase use the "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgres://postgres:password@localhost:5432/khulafa

# Password for the owner dashboard at /admin
ADMIN_PASSWORD=change-me-to-something-long

# Optional. Random secret used to sign login cookies. If empty, one is derived
# from DATABASE_URL. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public address of the site, used in the printed QR codes.
# Leave empty to use whatever address you open the admin page with.
PUBLIC_BASE_URL=https://your-domain.com
